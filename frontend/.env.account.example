# Copy this value into the reviewed production build environment to enable central mode.
# Omit or leave empty for the original native login flow. No trailing slash/path/query.
VITE_RITEL_ACCOUNT_ORIGIN=https://account.ritel.si
# Central console API calls always use same-origin /api/v1 (the Node BFF).
# For local development VITE_DEV_PROXY_TARGET must point to that console BFF.
